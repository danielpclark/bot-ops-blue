{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -n \"$BOT_OPS_URL\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bot-ops-report.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -n \"$BOT_OPS_URL\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bot-ops-report.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -n \"$BOT_OPS_URL\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bot-ops-report.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -n \"$BOT_OPS_URL\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bot-ops-report.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -n \"$BOT_OPS_URL\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bot-ops-report.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -n \"$BOT_OPS_URL\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bot-ops-report.py\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
