#!/usr/bin/env ruby
# frozen_string_literal: true

# Reports this machine's Claude Code sessions to a Bot Ops Blue dashboard.
#
#   BOT_OPS_COLLECTOR=http://<dashboard-host>:47800 BOT_OPS_TOKEN=<token> bin/bot-ops-agent
#
# Needs only Ruby 3.0+ (standard library) and a checkout of this repo. It
# reads ~/.claude locally (see lib/bot_ops/probe.rb) and POSTs a snapshot
# every BOT_OPS_INTERVAL seconds (default 3). Snapshots include session
# names, project paths, prompt excerpts and tool-call details, so point it
# only at a dashboard on a network you trust (LAN, Tailscale, SSH tunnel).
#
#   --once    send one snapshot, print the result, and exit

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "net/http"
require "uri"
require "json"
require "bot_ops/probe"

collector = ENV["BOT_OPS_COLLECTOR"].to_s
token = ENV["BOT_OPS_TOKEN"].to_s
interval = Float(ENV.fetch("BOT_OPS_INTERVAL", "3"))
once = ARGV.include?("--once")

abort "Set BOT_OPS_COLLECTOR (e.g. http://my-mac.local:47800)" if collector.empty?
abort "Set BOT_OPS_TOKEN to the dashboard's token" if token.empty?

uri = URI.join(collector.end_with?("/") ? collector : "#{collector}/", "v1/snapshot")
probe = ENV["BOT_OPS_HOST"] ? BotOps::Probe.new(host: ENV["BOT_OPS_HOST"]) : BotOps::Probe.new
last_error = nil

loop do
  begin
    body = JSON.generate(probe.snapshot)
    res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 3, read_timeout: 5) do |http|
      req = Net::HTTP::Post.new(uri, "Content-Type" => "application/json", "Authorization" => "Bearer #{token}")
      req.body = body
      http.request(req)
    end
    raise "HTTP #{res.code} #{res.body}" unless res.is_a?(Net::HTTPSuccess)
    if last_error || once
      warn "bot-ops-agent: reporting #{probe.host} to #{uri} (#{body.bytesize / 1024} KB)"
      last_error = nil
    end
  rescue StandardError => e
    msg = "#{e.class}: #{e.message}"
    warn "bot-ops-agent: #{msg}" unless msg == last_error # log each new problem once
    last_error = msg
    exit 1 if once
  end
  break if once
  sleep interval
end
