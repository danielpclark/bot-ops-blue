# frozen_string_literal: true

require "rake/testtask"
require "rbconfig"
require "fileutils"

ROOT = File.expand_path(__dir__)
CRATE = File.join(ROOT, "ext", "bot_ops_native")
NATIVE_DIR = File.join(ROOT, "lib", "bot_ops", "native")
HOST_OS = RbConfig::CONFIG["host_os"]
MAC = HOST_OS =~ /darwin/ ? true : false
WINDOWS = HOST_OS =~ /mswin|mingw/ ? true : false
BUILT = MAC ? "libbot_ops_native.dylib" : (WINDOWS ? "bot_ops_native.dll" : "libbot_ops_native.so")
INSTALLED = File.join(NATIVE_DIR, "bot_ops_native.#{MAC ? 'bundle' : 'so'}")

def cargo?
  system("cargo", "--version", out: File::NULL, err: File::NULL)
end

desc "One-time setup: install gems and build the native window (needs Rust)"
task :setup do
  unless cargo?
    abort <<~MSG
      Rust toolchain not found. Install it (one command, all platforms):
        https://rustup.rs
      then re-run: bundle exec rake setup
    MSG
  end
  sh "bundle install"
  Rake::Task[:compile].invoke
  puts
  puts "Setup complete. Start the dashboard with: bundle exec rake run"
end

desc "Build the Rust extension with cargo and install it under lib/bot_ops/native"
task :compile do
  abort "cargo not found; install Rust from https://rustup.rs" unless cargo?
  sh "cargo", "build", "--release", "--manifest-path", File.join(CRATE, "Cargo.toml")
  FileUtils.mkdir_p(NATIVE_DIR)
  FileUtils.cp(File.join(CRATE, "target", "release", BUILT), INSTALLED)
  puts "Installed #{INSTALLED}"
end

desc "Create the collector token (~/.config/bot-ops-blue/token) if it does not exist"
task :token do
  require "securerandom"
  path = File.join(Dir.home, ".config", "bot-ops-blue", "token")
  unless File.exist?(path)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, SecureRandom.hex(24) + "\n", perm: 0o600)
  end
  puts "Token: #{path}"
end

# ---- ngrok tunnel for cloud sessions (see README: Cloud sessions) ----------

CONFIG_DIR = File.join(Dir.home, ".config", "bot-ops-blue")
NGROK_POLICY = File.join(CONFIG_DIR, "ngrok-policy.yml")
NGROK_BASIC = File.join(CONFIG_DIR, "ngrok-basic-auth")

namespace :ngrok do
  desc "Write ~/.config/bot-ops-blue/ngrok-policy.yml (basic auth at ngrok's edge; the password is the collector token)"
  task policy: :token do
    collector_token = File.read(File.join(CONFIG_DIR, "token")).strip
    File.write(NGROK_BASIC, "botops:#{collector_token}\n", perm: 0o600)
    policy = File.read(File.join(ROOT, "cloud", "ngrok-policy.example.yml"))
                 .sub("REPLACE_WITH_~/.config/bot-ops-blue/token", collector_token)
                 .sub(/\A(#.*\n)+/, "# Generated by `rake ngrok:policy` from cloud/ngrok-policy.example.yml. Secret: keep 0600.\n")
    File.write(NGROK_POLICY, policy, perm: 0o600)
    File.chmod(0o600, NGROK_POLICY, NGROK_BASIC)
    puts "Wrote #{NGROK_POLICY}"
    puts "Network secret value (prefix Basic):  ruby -e 'print [File.read(\"#{NGROK_BASIC}\").strip].pack(\"m0\")'"
  end

  desc "Start the tunnel: rake ngrok:tunnel DOMAIN=<your-static-domain>.ngrok-free.dev"
  task :tunnel do
    domain = ENV["DOMAIN"].to_s.sub(%r{\Ahttps?://}, "")
    abort "Usage: rake ngrok:tunnel DOMAIN=<your-static-domain>.ngrok-free.dev" if domain.empty?
    abort "Run `rake ngrok:policy` first" unless File.exist?(NGROK_POLICY)
    port = ENV.fetch("BOT_OPS_LISTEN", "127.0.0.1:47800").split(":").last
    # 127.0.0.1 rather than localhost (which may resolve to ::1); no local
    # inspector, since it would record prompt excerpts.
    exec "ngrok", "http", "127.0.0.1:#{port}", "--url", "https://#{domain}",
         "--traffic-policy-file", NGROK_POLICY, "--inspect=false"
  end
end

# ---- cloud environment setup script ----------------------------------------

namespace :cloud do
  desc "Regenerate cloud/setup.sh (paste into the claude.ai/code environment's Setup script)"
  task :setup_script do
    $LOAD_PATH.unshift(File.join(ROOT, "lib"))
    require "bot_ops/cloud_setup"
    File.write(BotOps::CloudSetup::PATH, BotOps::CloudSetup.script)
    puts "Wrote #{BotOps::CloudSetup::PATH}"
  end
end

desc "Regenerate lib/bot_ops/icons.rb from Lucide's SVG icons (needs the network)"
task :icons do
  require_relative "lib/bot_ops/icon_builder"
  puts "Wrote #{BotOps::IconBuilder.build} icons to #{BotOps::IconBuilder::PATH}"
end

desc "Regenerate lib/bot_ops/font_metrics.rb from the bundled fonts"
task :metrics do
  require_relative "lib/bot_ops/metrics_builder"
  puts "Wrote metrics for #{BotOps::MetricsBuilder.build} fonts to #{BotOps::MetricsBuilder::PATH}"
end

desc "Run the Bot Ops Blue desktop app"
task :run do
  Rake::Task[:compile].invoke unless File.exist?(INSTALLED)
  ruby File.join(ROOT, "bot_ops_blue.rb")
end

Rake::TestTask.new(:test) do |t|
  t.libs << "lib" << "test"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = false
end

desc "Render every page to SVG in tmp/preview (no display or Rust needed)"
task :preview do
  $LOAD_PATH.unshift(File.join(ROOT, "lib"))
  require "bot_ops"
  out = File.join(ROOT, "tmp", "preview")
  FileUtils.mkdir_p(out)
  host = BotOps::PreviewHost.new
  store = BotOps::Store.new
  scene = BotOps::Scene.new(store, host)
  store.apply(type: "snapshot", snapshot: BotOps::Probe.new.snapshot, local: true)
  BotOps::Layout::NAV.each do |key, _name, _glyph|
    store.page = key
    File.write(File.join(out, "#{key}.svg"), scene.build.to_svg)
  end
  puts "Wrote #{BotOps::Layout::NAV.size} pages to #{out}"
end

desc "Remove build artifacts"
task :clean do
  sh "cargo", "clean", "--manifest-path", File.join(CRATE, "Cargo.toml") if cargo?
  FileUtils.rm_rf(NATIVE_DIR)
  FileUtils.rm_rf(File.join(ROOT, "tmp"))
end

task default: :test
